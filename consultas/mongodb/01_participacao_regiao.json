[
  {
    "$group": {
      "_id": {
        "regiao_id": "$geografia.regiaoId",
        "regiao": "$geografia.regiao"
      },
      "fornecedores": {
        "$sum": "$quantidadeFornecedores"
      }
    }
  },
  {
    "$unionWith": {
      "coll": "dim_regiao",
      "pipeline": [
        {
          "$project": {
            "_id": {
              "regiao_id": "$_id",
              "regiao": "$nome"
            },
            "fornecedores": {
              "$literal": 0
            }
          }
        }
      ]
    }
  },
  {
    "$group": {
      "_id": "$_id",
      "fornecedores": {
        "$sum": "$fornecedores"
      }
    }
  },
  {
    "$group": {
      "_id": null,
      "total": {
        "$sum": "$fornecedores"
      },
      "linhas": {
        "$push": "$$ROOT"
      }
    }
  },
  {
    "$unwind": "$linhas"
  },
  {
    "$project": {
      "_id": 0,
      "fornecedores": "$linhas.fornecedores",
      "participacao_pct": {
        "$cond": [
          {
            "$gt": [
              "$total",
              0
            ]
          },
          {
            "$round": [
              {
                "$multiply": [
                  100,
                  {
                    "$divide": [
                      "$linhas.fornecedores",
                      "$total"
                    ]
                  }
                ]
              },
              4
            ]
          },
          null
        ]
      },
      "regiao_id": "$linhas._id.regiao_id",
      "regiao": "$linhas._id.regiao"
    }
  },
  {
    "$sort": {
      "fornecedores": -1,
      "regiao_id": 1
    }
  }
]